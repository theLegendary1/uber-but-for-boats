{
  "name": "dockwash",
  "version": "0.2.0",
  "private": true,
  "description": "Cleaners post the days they can wash; marina managers book them without the phone calls.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/*.test.js'",
    "test:ui": "playwright test",
    "test:ui:watch": "playwright test --ui",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report",
    "test:all": "npm test && npm run test:ui",
    "prepare": "node scripts/install-hooks.js",
    "test:versions": "node scripts/check-versions.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
